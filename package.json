{
	"name": "@supertiny99/dsh-usage-dashboard",
	"version": "0.2.0",
	"type": "module",
	"description": "DSH 本地用量分析工作台，按实际事件统计每日趋势、项目与模型用量，支持会话钻取和数据覆盖诊断。",
	"author": "supertiny99",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/supertiny99/dsh-usage-dashboard.git"
	},
	"bugs": {
		"url": "https://github.com/supertiny99/dsh-usage-dashboard/issues"
	},
	"homepage": "https://github.com/supertiny99/dsh-usage-dashboard#readme",
	"keywords": [
		"dsh",
		"deepseek",
		"cordis",
		"plugin",
		"token-usage",
		"dashboard",
		"analytics"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": "./index.js",
		"./client": "./dist/client.js",
		"./package.json": "./package.json",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"engines": {
		"dsh": ">=0.2.1-rc.5",
		"node": ">=20"
	},
	"files": [
		"index.js",
		"dist/client.js",
		"src/*.js",
		"cordis.patch.yml",
		"locale/*.json",
		"icon.svg",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"fzstd": "^0.1.1"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs && node scripts/selfcheck.mjs",
		"watch": "node scripts/build.mjs --watch",
		"test": "node --test tests/*.test.mjs",
		"preflight": "node scripts/preflight.mjs",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"esbuild": "^0.25.10",
		"jsdom": "27.0.1",
		"react": "19.2.0",
		"react-dom": "19.2.0"
	}
}
